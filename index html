<style>
*{margin:0;padding:0;box-sizing:border-box}
body{background:#f8f3eb;color:#574638;font-family:'Montserrat',sans-serif;text-align:center;overflow-x:hidden}

/* КОНВЕРТ - АШЫЛУ */
#envelopeScreen{position:fixed;inset:0;z-index:999;background:radial-gradient(ellipse at 50% 30%, #fffdf8, #f8f3eb 60%, #eaddc0);display:flex;flex-direction:column;align-items:center;justify-content:center;transition:transform 1.1s cubic-bezier(.77,0,.18,1)}
#envelopeScreen.hide{transform:translateY(-110%)}
.envBox{width:320px;height:200px;background:linear-gradient(145deg,#e8c87a,#c5a66b 50%,#a58a5d);border-radius:14px;position:relative;box-shadow:0 25px 50px rgba(139,115,53,.25);animation:float 3s ease-in-out infinite}
.envBox::before{content:'';position:absolute;top:0;left:0;right:0;height:100px;background:linear-gradient(145deg,#f0d896,#d4b268);clip-path:polygon(0 0,50% 65%,100% 0);border-radius:14px 14px 0 0}
.mono{position:absolute;top:60%;left:50%;transform:translate(-50%,-50%);width:86px;height:86px;background:#2b2118;border-radius:50%;display:grid;place-items:center;color:#f7e7d0;font-family:'Cormorant Garamond',serif;font-size:30px;border:1.5px solid #e8c87a;z-index:3}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-14px)}}
.openBtn{margin-top:32px;border:1px solid #c5a66b;padding:14px 32px;border-radius:50px;letter-spacing:5px;font-size:11px;cursor:pointer;background:#fffdf8cc;backdrop-filter:blur(10px);transition:.3s}
.openBtn:hover{background:#2b2118;color:#fffdf8}
.musicBtn{position:fixed;top:16px;right:16px;z-index:900;width:44px;height:44px;background:#fffdf8cc;border:1px solid #eaddc0;border-radius:50%;display:grid;place-items:center;cursor:pointer;backdrop-filter:blur(8px)}

/* НЕГІЗГІ */
.hero{min-height:100vh;display:flex;justify-content:center;align-items:center;padding:30px 20px;background:linear-gradient(#f8f3ebcc,#f8f3ebcc), url('background.jpg') center/cover}
.card{max-width:650px;width:100%;padding:55px 25px;border:1px solid #c5a66b;outline:5px double #c5a66b;outline-offset:8px;background:#fffdf8ed;box-shadow:0 15px 50px #8b735533}
.small{font-size:11px;letter-spacing:5px;color:#a58a5d}
.names{font-family:'Great Vibes',cursive;font-size:clamp(55px,12vw,85px);color:#a78953;margin:30px 0;line-height:1.2}
h1{font-family:'Cormorant Garamond',serif;font-size:42px;letter-spacing:5px;margin:20px 0;font-weight:500}
.text{font-size:14px;line-height:2;margin:20px auto;max-width:480px}
.gold-line{width:90px;height:1px;background:#b99a62;margin:25px auto}
.section{padding:70px 20px;max-width:750px;margin:auto}
.section h2{font-family:'Cormorant Garamond',serif;font-size:37px;color:#a78953;margin-bottom:25px}
.photoGrid{display:grid;grid-template-columns:1fr 1fr;gap:16px;max-width:500px;margin:30px auto}
.pBox{background:#fff;border:1px solid #eaddc0;border-radius:16px;overflow:hidden;aspect-ratio:3/4;position:relative;box-shadow:0 8px 25px #0001}
.pBox img{width:100%;height:100%;object-fit:cover}
.pBox .lbl{position:absolute;bottom:0;left:0;right:0;background:linear-gradient(transparent,rgba(43,33,24,.7));color:#fff8e7;padding:22px 10px 12px;font-size:11px;letter-spacing:3px}
.monoBox{display:grid;place-items:center;background:radial-gradient(circle at 50% 20%,#fffdf9,#fbf0df)}
.bigM{width:110px;height:110px;border-radius:50%;background:linear-gradient(145deg,#2b2118,#4a3a28);color:#f7e7d0;display:grid;place-items:center;font-family:'Cormorant Garamond',serif;font-size:64px;border:1.5px solid #c5a66b}
.btn{display:inline-block;padding:16px 30px;margin:12px 6px;border-radius:50px;text-decoration:none;font-size:11px;letter-spacing:3px;font-weight:500;transition:.3s}
.btn-dark{background:#2b2118;color:#fffdf8;border:1px solid #2b2118}
.btn-light{background:#fffdf8;color:#a78953;border:1px solid #c5a66b}
.countdown{display:flex;justify-content:center;gap:12px;flex-wrap:wrap;margin-top:30px}
.time-box{background:#fffdf8;border:1px solid #c5a66b;padding:18px 12px;min-width:75px;border-radius:12px}
.time-box strong{display:block;font-size:27px;color:#a78953}
.time-box span{font-size:10px}
</style>
</head>
